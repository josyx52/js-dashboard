{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "js-dashboard",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // De 15 em 15 min: ciclo do Holiday (automacoes); sync so de hora a hora
  // (ver handler `scheduled` em worker.ts)
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
